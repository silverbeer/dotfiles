[
  {"label": "BETC", "dirGlobs": ["bet-collect", "bet-capture"], "ghRepo": "bet-collect",
   "epicGlobs": ["*acquisition*", "*capture*"]},
  {"label": "BET",  "dirGlobs": ["bet", "bet-*", "*betting*"], "ghRepo": "bet",
   "epicGlobs": ["bet *", "bet-*"]},
  {"label": "STK",  "dirGlobs": ["myrunstreak*", "runstreak*"], "ghRepo": "myrunstreak.run",
   "epicGlobs": ["*goals*", "*multi-metric*", "*byok*", "*multi-source*", "*import*",
                 "*social*", "*community*", "*athlete*", "*training*", "*local*agent*",
                 "*automation*", "*agentic*", "*delivery*", "*quality*", "*ci*",
                 "*vision*", "*roadmap*", "*daily*coach*", "*route*"]},
  {"label": "MT",   "dirGlobs": ["missing-table"], "ghRepo": "missing-table",
   "epicGlobs": ["*paper*"], "note": "*paper* spans MT + STK; MT is the deadline half"},
  {"label": "POD",  "dirGlobs": ["podtelemetry*", "pod"], "ghRepo": "podtelemetry.com",
   "epicGlobs": ["*podtelemetry*", "*run*audio*"]},
  {"label": "MTA",  "dirGlobs": ["*android*"], "ghRepo": "missing-table-android",
   "epicGlobs": ["*android*"]},
  {"label": "TRD",  "dirGlobs": ["trd*", "*investment*"], "ghRepo": "trd",
   "epicGlobs": ["*trd*", "*investment*"]},
  {"label": "BOOT", "dirGlobs": ["missingtable-platform-bootstrap", "*bootstrap*"], "ghRepo": "missingtable-platform-bootstrap",
   "epicGlobs": []},
  {"label": "MS",   "dirGlobs": ["match-scraper"], "ghRepo": "match-scraper", "epicGlobs": []},
  {"label": "MSA",  "dirGlobs": ["match-scraper-agent"], "ghRepo": "match-scraper-agent", "epicGlobs": []},
  {"label": "QB",   "dirGlobs": ["qualityplaybook*", "qb"], "ghRepo": "qualityplaybook.dev", "epicGlobs": []},
  {"label": "JT",   "dirGlobs": ["janitor"], "ghRepo": "janitor", "epicGlobs": []},
  {"label": "DOT",  "dirGlobs": ["dotfiles"], "ghRepo": "dotfiles", "epicGlobs": []},
  {"label": "TODO", "dirGlobs": ["todo"], "ghRepo": "todo", "epicGlobs": []}
]
