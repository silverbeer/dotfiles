# Google Cloud SDK
export PATH="/opt/homebrew/share/google-cloud-sdk/bin:$PATH"

# SUPABASE_PG_URL is deliberately NOT set here any more.
#
# It was a template read of op://Personal/Supabase MSA. Once agent shells began
# exporting a service-account token, that read started failing — a service
# account can never be granted the built-in Personal vault — and the `|| true`
# added in SB-514 turned the failure into an empty value. The result was that
# `chezmoi apply` run by an agent rewrote this file with the variable missing,
# breaking the supabase-sql MCP server for the interactive shell.
#
# It now lives in ~/.config/supabase/pg-url, provisioned once by
# run_once_before_21-supabase-pg-url.sh and exported from ~/.zshenv. Apply never
# renders the secret, so apply can never drop it. Do not move it back.

alias k='kubectl'
export RESUME_DATA_DIR="{{ .chezmoi.homeDir }}/iCloud/resume-data"

# trd's portfolio DB (every real account) lives LOCALLY on the Mac mini, never in
# iCloud: real account data does not leave this machine (2026-10-24).
# Without this, a bare `trd` falls back to ~/.trd and silently creates an empty
# database there (SB-1366) — "No accounts", with the real data untouched but
# invisible. Guarded so a machine without the local portfolio keeps the default.
if [ -f "{{ .chezmoi.homeDir }}/.trd-portfolio/trd.duckdb" ]; then
  export TRD_HOME="{{ .chezmoi.homeDir }}/.trd-portfolio"
fi

# trd engines. Each engine has its own DuckDB, deliberately separate from the
# portfolio DB — so a bare `trd engine status` reads a database with no engine in
# it and answers "run 'trd engine init'", which is the one command that would
# wreck the live config (it rewrites the whole row: universe back to the default
# ten, flat_at_minute dropped). These aliases are how you avoid ever typing it.
alias trde='TRD_HOME={{ .chezmoi.homeDir }}/.trd-engine trd'   # swing: 25 names, 10 x $100, 1d
alias trdd='TRD_HOME={{ .chezmoi.homeDir }}/.trd-day trd'      # day: 20 names, 5 x $10, 15:55 flat

# trd --notify needs TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID, which live in
# ~/.config/trd/live.env (chmod 600) — the file the launchd jobs load. Without
# this, `trd engine close X --notify` in a terminal queues the order and sends
# nothing (SB-1743). Sourced in a SUBSHELL for the one command, so the token never
# stays in the terminal's environment. Skipped in agent shells (CLAUDECODE=1):
# an agent running `trd ... --notify` must not reach Telegram by accident.
# The aliases above expand to `trd`, so they go through this too.
if [[ -z "${CLAUDECODE:-}" ]]; then
  trd() {
    (
      [[ -r "{{ .chezmoi.homeDir }}/.config/trd/live.env" ]] && {
        set -a; source "{{ .chezmoi.homeDir }}/.config/trd/live.env"; set +a
      }
      command trd "$@"
    )
  }
fi

export APP_ENV={{ dig "appEnv" "prod" . }}

# missing-table backend venv on PATH. Guarded because this file is shared with a
# machine that may not have the repo checked out — an unguarded prepend would put
# a non-existent directory on PATH there. Recovered from drift: it had been
# appended directly to ~/.zshrc, which the next `chezmoi apply` would have eaten.
if [ -d "{{ .chezmoi.homeDir }}/gitrepos/missing-table/backend/.venv/bin" ]; then
  export PATH="{{ .chezmoi.homeDir }}/gitrepos/missing-table/backend/.venv/bin:$PATH"
fi

# Completion system. This used to live inside the OpenClaw block, so removing
# that tool (SB-392) silently took zsh completions with it — keep it standalone.
autoload -Uz compinit && compinit

# rcl REPO [HOST] — start Claude in ~/gitrepos/REPO on a Rex host (default
# mini), in a new Rex session named REPO. It keeps running on the host when this
# machine sleeps; open it from the Rex sidebar, or /remote-control from a phone.
rcl() {
  local repo=${1:?usage: rcl REPO [HOST]} host=${2:-mini} s
  s=$(rex -S "$host" new "$repo") || return
  if ! rex -S "$host" run -s "$s" --focus=false --wait -- \
      sh -c 'test -d "$HOME/gitrepos/$1"' sh "$repo" &>/dev/null; then
    echo "rcl: ~/gitrepos/$repo not found on $host" >&2
    rex -S "$host" kill "$s" >/dev/null
    return 1
  fi
  rex -S "$host" run -s "$s" --label claude >/dev/null -- \
    sh -c 'cd "$HOME/gitrepos/$1" && exec claude' sh "$repo" || return
  echo "claude running in $repo on $host (session ${s#session:})"
}

# Prompt (config: ~/.config/starship.toml). Shows repo, branch, dirty state and
# the Linear ticket parsed from the branch name. Keep this last — starship's
# init must run after anything that touches PROMPT.
eval "$(starship init zsh)"
