### MANAGED BY RANCHER DESKTOP START (DO NOT EDIT)
export PATH="{{ .chezmoi.homeDir }}/.rd/bin:$PATH"
### MANAGED BY RANCHER DESKTOP END (DO NOT EDIT)

[[ "$TERM_PROGRAM" == "kiro" ]] && . "$(kiro --locate-shell-integration-path zsh)"

# Added by CodeRabbit CLI installer
export PATH="{{ .chezmoi.homeDir }}/.local/bin:$PATH"

# Google Cloud SDK
export PATH="/opt/homebrew/share/google-cloud-sdk/bin:$PATH"

# Supabase PostgreSQL connection for MCP.
#
# Read through `output` rather than `onepasswordRead` on purpose. A template
# renders on *every* chezmoi invocation, so `onepasswordRead` failing against a
# locked vault aborted the whole command — including read-only `status` and
# `diff`, which are the only things that surface drift between ~/ and the source.
# On the mac mini that meant drift went unnoticed for weeks (SB-514).
#
# `|| true` keeps the exit status clean, so a locked vault degrades to an unset
# variable instead of an error. No single secret should be able to break `status`.
{{ $pgUrl := output "sh" "-c" "op read \"op://Personal/Supabase MSA/credential\" 2>/dev/null || true" | trim -}}
{{ if $pgUrl -}}
export SUPABASE_PG_URL="{{ $pgUrl }}"
{{ else -}}
# SUPABASE_PG_URL is unset: 1Password was locked when this file was last
# rendered. Unlock `op` and re-run `chezmoi apply` to restore it.
{{ end }}
alias k='kubectl'
export RESUME_DATA_DIR="{{ .chezmoi.homeDir }}/iCloud/resume-data"

# trd engines. Each engine has its own DuckDB, deliberately separate from the
# real ~/.trd — so a bare `trd engine status` reads a database with no engine in
# it and answers "run 'trd engine init'", which is the one command that would
# wreck the live config (it rewrites the whole row: universe back to the default
# ten, flat_at_minute dropped). These aliases are how you avoid ever typing it.
alias trde='TRD_HOME={{ .chezmoi.homeDir }}/.trd-engine trd'   # swing: 25 names, 10 x $100, 1d
alias trdd='TRD_HOME={{ .chezmoi.homeDir }}/.trd-day trd'      # day: 20 names, 5 x $10, 15:55 flat

export APP_ENV={{ dig "appEnv" "prod" . }}

# Completion system. This used to live inside the OpenClaw block, so removing
# that tool (SB-392) silently took zsh completions with it — keep it standalone.
autoload -Uz compinit && compinit

# Prompt (config: ~/.config/starship.toml). Shows repo, branch, dirty state and
# the Linear ticket parsed from the branch name. Keep this last — starship's
# init must run after anything that touches PROMPT.
eval "$(starship init zsh)"
